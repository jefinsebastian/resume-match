{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resume-match",
  "main": "worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "LEDGER", "class_name": "Ledger" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Ledger"] }
  ]
}
